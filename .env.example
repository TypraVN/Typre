# Copy file này thành .env rồi điền 2 giá trị từ Supabase Dashboard.
# Không có 2 giá trị này, app vẫn chạy bình thường — chỉ tab "Xếp hạng" và nút
# đăng nhập bị ẩn kèm thông báo chưa cấu hình.

# Project Settings > General (hoặc trang chủ project)
VITE_SUPABASE_URL=

# Project Settings > API Keys > "Publishable key" (dạng sb_publishable_...)
# Tên cũ là "anon public key" — dashboard mới gọi là Publishable key.
#
# CẢNH BÁO: KHÔNG dùng "Secret key" (sb_secret_...) ở đây. Secret key bỏ qua mọi
# Row Level Security; đưa vào frontend là ai cũng đọc/xoá được sạch database.
VITE_SUPABASE_ANON_KEY=
